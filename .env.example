# Independiente de Electron. No usar el proyecto Supabase de Electron.
# demo = ejemplos claramente identificados; live = solo datos publicados de Supabase.
CONTENT_MODE=demo
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# En modo live deben completarse las dos variables anteriores.
# Admite también la antigua clave anon, nunca service_role ni sb_secret_.
SITE_URL=http://localhost:3000
# Mantener false hasta tener fotografías autorizadas, contenido revisado y aviso de privacidad.
ALLOW_INDEXING=false
PORT=3000
